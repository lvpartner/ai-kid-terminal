ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/kid-terminal.db
ADMIN_API_KEY=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-a-different-32-character-secret
AI_PROVIDER=mock
DASHSCOPE_API_KEY=
QWEN_WORKSPACE_ID=
QWEN_REGION=cn-beijing
GROUNDED_MODEL=qwen3.5-plus
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
COSYVOICE_MODEL=cosyvoice-v3-flash
COSYVOICE_VOICE=longanyang
STRICT_GROUNDING=true
CONTEXT_TURNS=8
ENABLE_LONG_TERM_MEMORY=false
CONVERSATION_RETENTION_HOURS=24
TELEMETRY_RETENTION_DAYS=7
QWEN_EVENT_TIMEOUT_SECONDS=30
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
RELEASE_DIR=./releases
MINIMUM_DISK_FREE_KB=10485760
BACKUP_KEEP_COUNT=14
