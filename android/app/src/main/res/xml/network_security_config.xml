<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Runtime validation only permits HTTP for loopback, RFC1918, and .local family servers. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
